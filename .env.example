# FloodSight — Environment Configuration Example
# Copy this file to .env in your backend or frontend directory as needed.
# NEVER commit real credentials, passwords, or tokens to version control.

# Backend Configuration (FastAPI)
FLOODSIGHT_HOST=127.0.0.1
FLOODSIGHT_PORT=8000
FLOODSIGHT_LOG_LEVEL=info
FLOODSIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Copernicus Data Space Ecosystem (CDSE) Credentials (Optional for metadata search; required for bulk image download)
# Free registration at: https://dataspace.copernicus.eu/
COPERNICUS_CDSE_CLIENT_ID=your_cdse_client_id_here
COPERNICUS_CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# OpenStreetMap Overpass API Endpoint
# Default uses official public endpoint. You may configure a self-hosted or dedicated instance.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25

# Zenodo / STURM-Flood Settings
ZENODO_API_URL=https://zenodo.org/api/records/12748983

# Copernicus EMS Mapping Portal URL
COPERNICUS_EMS_URL=https://emergency.copernicus.eu/mapping/list-of-activations-rapid

# Frontend API URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api
